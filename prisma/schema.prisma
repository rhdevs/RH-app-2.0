// schema.prisma
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Post {
  id        String   @id @map("_id") @db.ObjectId // Use String and map it to "_id"
  name      String
  createdAt DateTime @default(now())
  createdBy User     @relation(fields: [createdById], references: [id])
  createdById String
}

model User {
  id      String   @id @map("_id") @db.ObjectId // Use String and map it to "_id"
  name    String
  email   String   @unique
  posts   Post[]
}

model Account {
  id      String @id @map("_id") @db.ObjectId // Use String and map it to "_id"
  userId  String
}

model Session {
  id           String @id @map("_id") @db.ObjectId // Use String and map it to "_id"
  sessionToken String @unique
}

model VerificationToken {
  id         String   @id @map("_id") @db.ObjectId // Use MongoDB's default _id field
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token]) // Unique constraint on the combination of identifier and token
}
