  max     Int
  min     Int
  options FoodOrderDataCustomOptions[]
  title   String
}

type FoodOrderDataCustomOptions {
  isSelected Boolean
  name       String
  /// Multiple data types found: Float: 45.2%, Int: 54.8% out of 42 sampled entries
