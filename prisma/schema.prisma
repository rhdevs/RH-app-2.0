}

model BookingLogs {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  action       String
  /// Multiple data types found: Int: 98.2%, BigInt: 1.8% out of 114 sampled entries
  bookUntil    Json?
  /// Multiple data types found: String: 23.6%, Int: 76.4% out of 971 sampled entries
  bookingID    Json?
  ccaID        Int?
  description  String?
  endDate      Int?
  endTime      Int?
  eventName    String?
  facilities   Int[]
  facilityID   Int?
  /// Multiple data types found: Boolean: 86.2%, Int: 13.8% out of 145 sampled entries
  forceBook    Json?
  forceBooking Boolean?
  repeat       Int?
  startTime    Int?
  timeStamp    String?
  userID       String?
}

model Bookings {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  bookUntil   Int?
  bookingID   Int      @unique
  ccaID       Int
  description String?
  endTime     Int
  eventName   String?
  facilityID  Int
  forceBook   Boolean?
  repeat      Int?
  startTime   Int
  userID      String

  @@index([facilityID, startTime, endTime], map: "facility + time")
  @@index([userID], map: "userID")
  @@index([userID, startTime, endTime], map: "user_time")
}

