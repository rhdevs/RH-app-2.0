  min     Int
  options FoodMenuCustomOptions[]
  title   String
}

type FoodMenuCustomOptions {
  name  String
  /// Multiple data types found: Float: 44%, Int: 56% out of 1578 sampled entries
  price Json
}

type FoodOrderCustom {
  max     Int
  min     Int
  options FoodOrderCustomOptions[]
  title   String
}

type FoodOrderCustomOptions {
  isSelected Boolean
  name       String
  /// Multiple data types found: Float: 34.2%, Int: 65.8% out of 468 sampled entries
  price      Json
}

