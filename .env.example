# Copy this file to ".env" (or ".env.local") and fill in real values.
# This file is committed to version control, so it must NOT contain secrets.
#
# When adding environment variables, update the schema in "/src/env.js" too.

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="mongodb://localhost:27017/rhapp"

# Next Auth
# Generate a real secret with:  openssl rand -base64 32
# Do NOT ship a placeholder like "secretstring" to production.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Public origin used to build absolute links in emails (password reset).
# Falls back to NEXTAUTH_URL when unset.
APP_URL="http://localhost:3000"

# Password hashing cost factor (bcrypt). Optional; defaults to 12.
BCRYPT_ROUNDS=12

# Transactional email (password reset links) — https://resend.com
RESEND_API_KEY=""

# Google OAuth (optional — the provider is only enabled when both are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Signing key for event check-in QR codes (src/server/api/services/eventQr.ts).
# Generate with:  openssl rand -base64 48
# Optional at build time, and REQUIRED IN FACT for the door: without it every
# scan fails closed with ATTENDANCE_NOT_CONFIGURED and event.attendanceStatus
# reports which of the two things is missing. Must be at least 32 characters.
EVENT_QR_SECRET=""
